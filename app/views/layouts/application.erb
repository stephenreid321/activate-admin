<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= ENV['ADMIN_SITE_NAME'] || 'ActivateAdmin' %></title>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <% {
         'bootstrap/5.3.8' => 'css/bootstrap.min.css js/bootstrap.bundle.min.js',
         'bootstrap-icons/1.13.1' => 'font/bootstrap-icons.min.css',
         'flatpickr/4.6.13' => 'flatpickr.min.js flatpickr.min.css',
         'select2/4.1.0' => 'js/select2.full.min.js css/select2.min.css',
         'select2-bootstrap-5-theme/1.3.0' => 'select2-bootstrap-5-theme.min.css'
       }.each { |k,v| %>
    <% v.split(' ').each { |f| u = "https://cdnjs.cloudflare.com/ajax/libs/#{k}/#{f}" %>
    <% case f.split('.').last.to_sym; when :js %>
      <script src="<%= u %>"></script>
    <% when :css %>
      <link rel="stylesheet" href="<%= u %>">
    <% end %>
    <% } %>
    <% } %>

    <link rel="stylesheet" href="<%= ActivateAdmin::App.uri_root %>/stylesheets/app.css">

    <% [
         'https://rawcdn.githack.com/symbiota-coop/dandelion/579e0d3646ed9f043e84ff06e2b0f4f9a37977bf/app/assets/javascripts/ext/jquery-deparam.js',
         'https://rawcdn.githack.com/symbiota-coop/dandelion/579e0d3646ed9f043e84ff06e2b0f4f9a37977bf/app/assets/javascripts/jquery.lookup.js',
         "#{ActivateAdmin::App.uri_root}/javascripts/app.js"
       ].each { |f| %>
    <script src="<%= f %>"></script>
    <% } %>

  </head>
  <body>

    <%= partial :alert %>
    <%= partial :nav %>

    <div class="container-fluid">
      <%= yield %>
    </div>

  </body>
</html>
