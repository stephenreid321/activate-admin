<div class="col-sm-8 mx-auto">
  <% form_tag url(:login) do %>

    <div class="mb-3">
      <label class="form-label">Email</label>
      <%= text_field_tag :email, value: params[:email], class: 'form-control' %>
    </div>

    <div class="mb-3">
      <label class="form-label">Password</label>
      <%= password_field_tag :password, value: params[:password], class: 'form-control' %>
    </div>

    <% if Padrino.env == :development %>
      <div class="form-check mb-3">
        <%= check_box_tag :bypass, id: 'bypass', class: 'form-check-input' %>
        <label class="form-check-label" for="bypass">Bypass login?</label>
      </div>
    <% end %>

    <div class="mb-3">
      <button class="btn btn-primary" type="submit">Sign in</button>
    </div>

  <% end %>
</div>
